@{
    var info = ViewData["pageModel"] as RectImageArchiveMillikitap.Models.Pages;
    ViewBag.Title = $"Редактирование: {info.Title}";
    string EditorSVGOriginal = (string)ViewData["EditorSVGOriginal"];
    string imageUrl = (string)ViewData["imageUrl"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    string version = "1.1.7";
}
@* GRID LAYOUT: https://codepen.io/rpieciorak/pen/mdroYLz *@
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/bootstrap-theme.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
<link href="~/editor/image-map.css?v=@version" rel="stylesheet" />
<link href="~/Content/loading.css" rel="stylesheet" />
@* Froalla Editor *@
<link href="~/editor_froalla/froala_editor.pkgd.min.css" rel="stylesheet" />
<!-- Include Editor JS files. -->
<script src="~/editor_froalla/froala_editor.pkgd.min.js"></script>
<script src="~/editor_froalla/lang_ru.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js" integrity="sha256-VazP97ZCwtekAsvgPBSUwPFKdrwD3unUfSGVYrahUqU=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
@* TagsInput *@
<link href="~/Content/TagsInput/jquery.tagsinput-revisited.css" rel="stylesheet" />
<script src="~/Content/TagsInput/jquery.tagsinput-revisited.js"></script>
<script>
    var editorFroalla;
    function initFroalla() {
        editorFroalla = new FroalaEditor('#editor', {
            useClasses: false,
            pastePlain: true,
            htmlRemoveTags: ['script', 'style', 'base'],
            htmlExecuteScripts: false,
            events: {
                initialized: function () {
                    editorFroalla = this;
                }
            },
            toolbarButtons: ['undo', 'redo', '|', 'bold', 'underline', 'insertTable', 'fontSize', 'textColor', 'strikeThrough', 'subscript', 'superscript', 'outdent', 'indent', 'clearFormatting', 'insertTable', 'html', 'insertLink', 'video'],
            toolbarButtonsXS: ['undo', 'redo', '-', 'bold', 'underline', 'insertTable', 'fontSize', 'textColor', 'insertLink', 'video'],
            language: 'ru'
        });
    }
    function scrollCfg() {
        $('.fullHeight').css('max-height', window.outerHeight).css('height', window.outerHeight);
    }
    function resizeEvent() {
        $(window).resize(function () {
            scrollCfg();
        });
        $(window).trigger('resize');
    }
    var personsArr, eventsArr, placesArr, organizationsArr;
    function getAutocompleteData() {
        console.log('getAutocompleteData');
        $.ajax({
            type: "POST",
            url: '/TimesMachine/getAutocompleteData',
            success: function (data) {
                personsArr = data.Persons;
                eventsArr = data.Events;
                placesArr = data.Places;
                organizationsArr = data.Organizations;
            }, error: function () {

            }
        });
    }
    $(document).ready(function () {
        scrollCfg();
        //initDrag();
        getAutocompleteData();
        resizeEvent();
        app.loadImage($('#BlobImageLoad').html());
        loadSVG();
        initFroalla();
        layerTrigger();
    });
    function loadSVG() {
        var EditorSVGOriginal = $('#EditorSVGOriginal').html();
        if (!EditorSVGOriginal != null && EditorSVGOriginal != "") {
            areasIO.fromJSON($('#EditorSVGOriginal').text());
        } else {
            $('#loading').hide();
        }
    }
    function saveEdit() {
        triggerSave($('#layerTrigger'));
        $('#RectEditorSVGOriginal').val(areasIO.toJSON(true));
        $('#RectForViewerSVG').val(app.getHTMLCode());
        if (imageIsEdit) {
            $('#BlobImage').val(areasIO.toJSON(false).img);
        }
        $('#saveEditForm').submit();
        $('.loader').css('display', 'flex');
    }
    function triggerSave(el) {
        try {
            app.getSelectedArea()._attributes.html = editorFroalla.html.get();//.replace(/"/g, "***");
            app.getSelectedArea()._attributes.articleTitle = $('#articleTitle').val();
        }
        catch { }
        $(el).hide();
        $('.fr-box,.articleTitle,.editorPanelEdit').hide();
    }
    function layerTrigger() {
        $('#layerTrigger').on('click', function () {
            triggerSave(this);
        });
    }
    function autoComplete(control) {
        var id = $(control).attr('data-id');//1=person,2=event,3=place,4=organization
        var text = $(control).val();
        switch (parseInt(id)) {
            case 1:
                {
                    app.getSelectedArea()._attributes.person = text;
                } break;
            case 2:
                {
                    app.getSelectedArea()._attributes.event = text;
                } break;
            case 3:
                {
                    app.getSelectedArea()._attributes.place = text;
                } break;
            case 4:
                {
                    app.getSelectedArea()._attributes.organization = text;
                } break;
        }
    }
</script>

<div id="container">
    <div id="headerA">
        <span class="material-icons">
            crop
        </span>&nbsp;Редактор артефактов
    </div>
    <div id="mapA">
        <div id="map-wrapper">
            <div class="zoomBtn">
                <a><span class="material-icons zoom_ctrl" data-attr="plus">control_point</span></a>
                <a><span class="material-icons zoom_ctrl" data-attr="minus">remove_circle_outline</span></a>
            </div>
            <div id="map">
                <div>
                    <div id="get_image_wrapper">
                        <div id="get_image">
                            <span title="close" class="close_button"></span>
                            <div id="logo_get_image">

                            </div>
                            <div id="loading">Загрузка</div>
                            <div id="file_reader_support">
                                <label>Переместите изображение</label>
                                <div id="dropzone">
                                    <span class="clear_button" title="clear">x</span>
                                    <img src="" alt="preview" id="sm_img" />
                                </div>
                                <b style="display:none;">или</b>
                            </div>
                            <div style="display:none;">
                                <label for="url">укажите URL адрес к изображению</label>
                                <span id="url_wrapper">
