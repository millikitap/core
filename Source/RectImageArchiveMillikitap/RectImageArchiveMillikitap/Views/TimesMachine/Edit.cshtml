                        <li id="new_image"><a href="#">Новое изображение (сбросить все)</a></li>
                        <li style="display:none;" id="show_help"><a href="#">?</a></li>
                        <li><a onclick="saveEdit()" class="saveBtn" href="#">
                            <span class="material-icons">save</span> Сохранить документ</a>
                        </li>
                        <li><a href="@Url.Action("View","TimesMachine",new { @BookId = info.Book.BookId,  @pageId = info.Id })" target="_blank">Посмотреть документ</a></li>
                    </ul>
                </nav>
            </div>
            <div class="chart">
                <div class="editorPanelEdit">
                    <div>
                        <div class="form-group articleTitle" style="display:none;">
                            <label for="formGroupExampleInput">Название статьи</label>
                            <input type="text" class="form-control" id="articleTitle" onchange="app.setArticleTitleText()" placeholder="Заголовок">
                        </div>
                        @Html.TextArea("editor", new { id = "editor" })
                        <div class="editorCtrlBtn">
                            <button onclick="triggerSave('#layerTrigger');" class="btn btn-default">закрыть</button>
                        </div>
                    </div>
                    <div id="coords"></div>
                    <div id="debug"></div>
                </div>
            </div>
        </div>
    </div>
</div>



<body>
    <div class="loader">
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--text"></div>
    </div>

    @using (Html.BeginForm("saveChanges", "TimesMachine", FormMethod.Post, new { id = "saveEditForm" }))
    {
        @Html.Hidden("bookId", info.Book.BookId, new { @id = "bookId" })
        @Html.Hidden("pageId", info.Id, new { @id = "pageId" })
        @Html.TextArea("RectEditorSVGOriginal", EditorSVGOriginal, new { @id = "RectEditorSVGOriginal", @style = "display:none" })
        @Html.TextArea("RectForViewerSVG", new { @id = "RectForViewerSVG", @style = "display:none" })
        @Html.TextArea("BlobImage", new { @id = "BlobImage", @style = "display:none" })
        @Html.TextBox("imageUrl", imageUrl, new { @id = "imageUrl", @style = "display:none" })
    }
    <div style="display:none;" id="BlobImageLoad">@info.BlobImage</div>
    <div style="display:none;" id="EditorSVGOriginal">@EditorSVGOriginal</div>
    <noscript>
        <div id="noscript">
            Javascript отключен в браузере.
        </div>
    </noscript>
    <form id="edit_details">
        <h5>Attributes</h5>
        <span class="close_button" title="close"></span>
        <p>
            <label for="href_attr">href</label>
            <input type="text" id="href_attr" />
        </p>
        <p>
            <label for="alt_attr">alt</label>
            <input type="text" id="alt_attr" />
        </p>
        <p>
            <label for="title_attr">title</label>
            <input type="text" id="title_attr" />
        </p>
        <button id="save_details">Save</button>
    </form>

    <div id="from_html_wrapper">
        <form id="from_html_form">
            <h5>Loading areas</h5>
            <span class="close_button" title="close"></span>
            <p>
                <label for="code_input">Enter your html code:</label>
                <textarea id="code_input"></textarea>
            </p>
            <button id="load_code_button">Load</button>
        </form>
    </div>    
    <script src="~/editor/image-map.js??v=@version"></script>
    <script>
        //init zoom_ctrl
        let defaultZoom = 1;
        let cZoom = 1.2;
        let wrapperEl = $('#wrapper');
        let map = $('#map');
        function scrollEvent() {
            $(map).on('scroll', function () {
                app.recalcOffsetValues();
            });
        }
        function initScaleBindFunction() {
            $('.zoom_ctrl').on('click', function () {
                var dataAttr = $(this).attr('data-attr');
                switch (dataAttr) {
                    case "plus":
                        {
                            defaultZoom = defaultZoom * cZoom;
                        } break;
                    case "minus":
                        {
                            defaultZoom = defaultZoom / cZoom;
                        } break;
                }
                //$(wrapperEl).css('transform-origin', 'center top');
                $(wrapperEl).css('transform', 'scale3d(' + defaultZoom + ', ' + defaultZoom + ', ' + defaultZoom + ')');
                app.recalcOffsetValues();
            });
        }
        $(document).ready(function () {
            scrollEvent();
            initScaleBindFunction();
        });
    </script>
</body>

