@using RectImageArchiveMillikitap.Models;
@{string version = "2.1.6";}
<link href="~/Content/ControlPanel/uploader.css?v=@version" rel="stylesheet" />
@* Uploader *@
<link href="~/Content/Uploader/uploadfile.css?v=@version" rel="stylesheet" />
<script src="~/Content/Uploader/jquery.uploadfile.min.js?v=@version"></script>
@* Select *@
<link href="~/Content/Select2/select2.min.css?v=@version" rel="stylesheet" />
<script src="~/Content/Select2/select2.min.js?v=@version"></script>
@* Hijri calendar *@
<link href="~/Content/HijriCalendar/bootstrap-datetimepicker.min.css" rel="stylesheet" />
@*<script src="~/Content/HijriCalendar/momentjs.js"></script>*@
<script src="~/Content/HijriCalendar/moment-with-locales.js"></script>
<script src="~/Content/HijriCalendar/moment-hijri.js"></script>
<script src="~/Content/HijriCalendar/bootstrap-hijri-datetimepicker.js"></script>
<link href="~/Content/EditorBook/EditorBook.css?v=@version" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.form/4.3.0/jquery.form.min.js" integrity="sha384-qlmct0AOBiA2VPZkMY3+2WqkHtIQ9lSdAsAn5RUJD/3vA5MKDgSGcdmIv4ycVxyn" crossorigin="anonymous"></script>
@* Ion RangeSlider *@
<link href="~/Content/IonRangeSlider/ion.rangeSlider.css?v=@version" rel="stylesheet" />
<script src="~/Content/IonRangeSlider/ion.rangeSlider.min.js?v=@version"></script>
@{
    ViewBag.Title = "Редактирование книги";
    Layout = "~/Views/Shared/_LayoutControl.cshtml";
    var info = ViewData["BookInfo"] as RectImageArchiveMillikitap.Models.Books;
    var progress = 0;
    bool isExrimistStatements = info != null && info.Attributes != null && info.Attributes.isExrimistStatements.HasValue ? info.Attributes.isExrimistStatements.Value : false;
    if (info != null)
    {
        if (info.Attributes != null)
        {
            if (info.Attributes.PercentWorkDescr.HasValue)
            {
                progress += info.Attributes.PercentWorkDescr.Value;
            }
            if (info.Attributes.PercentWorkProcessing.HasValue)
            {
                progress += info.Attributes.PercentWorkProcessing.Value;
            }
            if (info.Attributes.PercentWorkScanner.HasValue)
            {
                progress += info.Attributes.PercentWorkScanner.Value;
            }
            progress = progress / 3;
        }
    }
    string pathBook = (string)ViewData["folderBookUrl"];
    //Первая страница
    var firstPage = new RectImageArchiveMillikitap.Models.Pages();
    //Список пользователей
    var usersForControlBook = ViewData["Users"] as List<RectImageArchiveMillikitap.Models.UsersForControlBook>;
    if (info != null)
    {
        if (info.Pages.Any())
        {
            firstPage = info.Pages?.FirstOrDefault();
        }
    }
    else
    {
        firstPage = null;
    }
    var userId = (int)ViewData["UserId"];
    var isGrantUser = (bool)ViewData["GrantUser"];
    //Состояния
    var statesList = (ViewData["StatesList"] as List<RectImageArchiveMillikitap.Models.States>)?.OrderBy(c => c.StateDescription)?.ToList();
    //Языки
    var langList = (ViewData["LangList"] as List<RectImageArchiveMillikitap.Models.LanguageTableList>)?.OrderBy(c => c.LanguageTableName)?.ToList();
    //Тематики
    var themesList = ViewData["ThemesList"] as List<RectImageArchiveMillikitap.Models.ThemesLanguagesList>;
    //Типы
    var typesList = ViewData["TypesList"] as List<RectImageArchiveMillikitap.Models.TypesLanguagesList>;
    //Регионы
    var regionsList = ViewData["RegionsList"] as List<RectImageArchiveMillikitap.Models.Regions>;
    //Коллекции
    var collectionsList = ViewData["CollectionsList"] as List<RectImageArchiveMillikitap.Models.Collection>;
    //Сборник сочинений
    var inventoryCollectedList = ViewData["InventoryCollectedList"] as List<string>;
    var namesCollectedList = ViewData["NamesCollectedList"] as List<string>;
}
<body>
    <div class="current-page">
        <a title="Обновить страницу ПУ" href="@Url.Action("ControlPanel","TimesMachine")">
            <img width="55" src="~/Content/Images/logo_main.png?v=@version" class="custom-logo" srcset="/Content/Images/logo_main.png?v=@version" sizes="(max-width: 300px) 100vw, 300px">
        </a>
        <ul class="bc">
            <li>ПУ</li>
            <li><span class="p_curr">Редактирование книги</span></li>
        </ul>
    </div>
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-2 inset_shadow">
                <div class="card">
                    <div class="card__image no_round">
                        @{
                            if (info != null)
                            {
                                if (!String.IsNullOrEmpty(info.BookCoverFileName))
                                {
                                    <img id="coverImg" class="zoom" loading="lazy" src="@pathBook@(string.Format("{0}", info.BookCoverFileName))" />
                                }
                                else
                                {
                                    <img id="coverImg" class="zoom" loading="lazy" src="@(Url.Content("/Content/Images/notImage.png"))" />
                                }
                                <text>
                                    <script>
                                      var pathBook = "@(string.Format("/Books/{0}/", info.HashFolder))";
                                    </script>
                                </text>
                            }
                            else
                            {
                                <img class="zoom" loading="lazy" src="@(Url.Content("/Content/Images/notImage.png"))" />
                            }
                        }
                    </div>
                    <div class="card__body">
                        @{
                            if (info != null)
                            {
                                <h2 class="user__name">@info.BookName</h2>
                                <p class="user__description">
                                    <div id="progress_book" class="progress-bar progress-bar-@(progress < 100 ? "info" : "success") progress-bar-striped" role="progressbar" aria-valuemin="0" aria-valuemax="100" style="width: @(string.Format("{0}%", progress));display:inline-table;">
                                        @(string.Format("{0}%", progress))
                                    </div>
                                </p>
                                <p class="user__description">
                                    @if (!info.Visible)
                                    {
                                        <span class="badge badge-danger">Скрыта</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">Опубликована</span>
                                    }
                                </p>
                            }
                            else
                            {
                                <h2 class="user__name">Мастер новой книги</h2>
                                <p class="user__description">
                                    <span class="badge badge-default">Черновик</span>
                                </p>
                                <p></p>
                            }
                        }
                    </div>
                    @if (info != null)
                    {
                        <div class="card__footer">
                            <a target="_blank" href="@Url.Action("View","TimesMachine",new { @BookId = info.BookId })" class="btn btn__primary"><i class="fa fa-external-link" aria-hidden="true"></i> Открыть книгу</a>
                        </div>
                    }
                </div>

                <small class="mb-2 d-inline-block text-muted"></small>
                <div class="list-group">
                    <a href="@Url.Action("ControlPanel","TimesMachine")" class="btn btn-default"><i class="fa fa-external-link"></i>&nbsp;&nbsp;В панель управления</a>
                    <a href="@Url.Action("Logout","Account")" class="btn btn-default"><i class="fa fa-sign-out"></i>&nbsp;&nbsp;Выйти</a>
                </div>
                <small class="mb-2 d-inline-block text-muted"></small>
                <div class="list-group">

                </div>
            </div>
            <div class="col-sm-10">
                <div class="panel-body">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="tab" href="#main" role="tab">Основные параметры книги</a>
                        </li>
                        @{
                            if (isGrantUser)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="tab" href="#attach" role="tab">Изображения @(info?.Pages?.Where(c => c.Visible).Count()) (страницы)</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="tab" href="#directory" role="tab">Справочники</a>
                                </li>
                            }

                        }
                    </ul>
                    <br />
                    <div class="tab-content">                        
                        <div class="tab-pane active" id="main" role="tabpanel">
                            @using (Html.BeginForm("SaveBook", "TimesMachine", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <h4>
                                    <i class="fa fa-book" aria-hidden="true"></i>
                                    @{
                                        if (info != null)
                                        {
                                            <span>Редактирование: Id=@info.BookId</span>
                                        }
                                        else
                                        {
                                            <span>Новая книга</span>
                                        }
                                    }
                                </h4>
                                if (info != null)
                                {
                                    <div style="color:#aaaaaa;">
                                        <i class="fa fa-pencil" aria-hidden="true"></i><span> Эксперт: @(info?.UserExpert?.Username)</span>
                                        @if (@info.UserIdCreator != null)
                                        {
                                            <span>, добавил(а) книгу: <i class="fa fa-lock" aria-hidden="true"></i> @info.UserIdCreator.Username</span>
                                        }
                                    </div>
                                }
                                <hr />
                                if (isExrimistStatements)
                                {
                                    <div class="alert alert-danger alert-dismissible" role="alert">
                                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
                                        <i class="fa fa-exclamation-triangle" aria-hidden="true"></i> Данная книга содержит сведения, которые могут быть признаны экстремистскими
                                    </div>
                                }

                                if (info != null)
                                {
                                    @Html.Hidden("BookId", info.BookId)
                                }
                                /* Accordion */
                                <div class="accordion form-group">
                                    <div class="accordion__item">
                                        <div class="accordion__title accordion-active">
                                            <div class="accordion__arrow accordion__rotate"><span class="accordion__arrow-item ">+</span></div>
                                            <span class="accordion__title-text">Первичное описание</span>
                                        </div>
                                        <div class="accordion__content" style="display: block;">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="bookName">
                                                            <span class="badge badge-danger">обязательное</span>
                                                            <strong>Название книги (оригинал)</strong>
                                                        </label>
                                                        <input type="text" value="@(info!=null ? info.BookName : string.Empty)" required="required" class="form-control" placeholder="Название" name="bookName" id="bookName">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="formFile" class="form-label">
                                                            @{
                                                                if (info != null)
                                                                {
                                                                    if (!string.IsNullOrEmpty(info.PdfFile))
                                                                    {
                                                                        <a href="~/Books/@info.HashFolder/@info.PdfFile"><span class="uploadFileNameBook"><i class="fa fa-download" aria-hidden="true"></i> @info.PdfFile</span>  </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="uploadFileNameBook">файл не загружен</span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span class="uploadFileNameBook">вложение</span>
                                                                }
                                                            }
                                                        </label>
                                                        <input class="form-control" type="file" name="fileBook">
                                                    </div>
                                                </div>
                                            </div>
                                            @*Millikitap поля*@
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="inv">Шифр (инвент. номер)</label>
                                                        <input type="text" value="@(info!=null && info.Attributes!=null ?info.Attributes?.Inventory:string.Empty)" class="form-control" placeholder="Шифр (инвент. номер)" name="Inventory" id="inv">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="width">Ширина (мм)</label>
                                                        <input type="number" value="@(info!=null && info.Attributes!=null ?info?.Attributes?.Width:0)" class="form-control" placeholder="Ширина" name="Width" min="0" id="width">
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="Height">Высота (мм)</label>
                                                        <input type="number" value="@(info!=null && info.Attributes!=null ?info?.Attributes?.Height:0)" class="form-control" placeholder="Высота" name="Height" min="0" id="Height">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="PageCount">Количество листов</label>
                                                        <input type="number" value="@(info!=null && info.Attributes!=null ?info?.Attributes?.PageCount:0)" class="form-control" placeholder="Количество листов" name="PageCount" id="PageCount">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="StatesId">
                                                            <button onclick="stateClass.getAll('#StatesId')" type="button"><i class="fa fa-refresh" aria-hidden="true"></i></button> Состояние
                                                        </label>
                                                        <select name="StatesId" id="StatesId" required class="form-control">
                                                            <option>-</option>
                                                            @{
                                                                if (statesList != null && statesList.Any())
                                                                {
                                                                    if (info != null && info.Attributes != null)
                                                                    {
                                                                        foreach (var l in statesList)
                                                                        {
                                                                            if (info.Attributes.StatesId.HasValue && info.Attributes.StatesId.Value == l.StatesId)
                                                                            {
                                                                                <option selected value="@l.StatesId">@l.StateDescription</option>
                                                                            }
                                                                            else
                                                                            {
                                                                                <option value="@l.StatesId">@l.StateDescription</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var l in statesList)
                                                                        {
                                                                            <option value="@l.StatesId">@l.StateDescription</option>
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <label>
                                                        <strong>
                                                            Перелистывание страниц справа налево
                                                        </strong>
                                                    </label>
                                                    <div class="flx">
                                                        <input type="checkbox" name="isRtl" id="isRtl" @(info != null ? info.isRtl.HasValue ? info.isRtl.Value ? "checked" : string.Empty : string.Empty : string.Empty) />
                                                        <label for="isRtl">Checkbox</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @* Сканирование/Обработка *@
                                    <div class="accordion__item">
                                        <div class="accordion__title">
                                            <div class="accordion__arrow"><span class="accordion__arrow-item ">+</span></div>
                                            <span class="accordion__title-text">Сканирование / Обработка</span>
                                        </div>
                                        <div class="accordion__content">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <h3>Сканирование</h3>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="StartDateScan">Дата начала по сканированию</label>
                                                        <input class="form-control" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.StartDateScan?.ToString("yyyy-MM-dd"):null)" id="StartDateScan" name="StartDateScan" type="date">
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="EndDateScan">Дата окончания по сканированию</label>
                                                        <input class="form-control" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.EndDateScan?.ToString("yyyy-MM-dd"):null)" id="EndDateScan" name="EndDateScan" type="date">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="FIOScanner">ФИО сканировщика</label>
                                                        <input type="text" class="form-control" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.FIOScanner:string.Empty)" id="FIOScanner" name="FIOScanner">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="PercentWorkScanner">Процент работы (<strong><span id="percentScanSpan">@(info!=null && info.Attributes!=null ? info?.Attributes?.PercentWorkScanner:0)</span>%</strong>)</label>
                                                        <input type="range" id="PercentWorkScanner" oninput="$('#percentScanSpan').html($(this).val())" class="progressDefault range" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.PercentWorkScanner:0)" name="PercentWorkScanner" min="0" max="100" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <h3>Обработка</h3>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="StartDateScanProcessing">Дата начала работ по обработке</label>
                                                        <input class="form-control" id="StartDateScanProcessing" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.StartDateScanProcessing?.ToString("yyyy-MM-dd"):null)" name="StartDateScanProcessing" type="date">
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="EndDateScanProcessing">Дата окончания работ по обработке</label>
                                                        <input class="form-control" id="EndDateScanProcessing" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.EndDateScanProcessing?.ToString("yyyy-MM-dd"):null)" name="EndDateScanProcessing" type="date">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="FIOProcessing">ФИО обработчика</label>
                                                        <input type="text" class="form-control" id="FIOProcessing" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.FIOProcessing:string.Empty)" name="FIOProcessing">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="PercentWorkProcessing">Процент работы (<strong><span id="percentWorkSpan">@(info!=null && info.Attributes!=null ? info?.Attributes?.PercentWorkProcessing : 0)</span>%</strong>)</label>
                                                        <input type="range" oninput="$('#percentWorkSpan').html($(this).val())" class="progressDefault" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.PercentWorkProcessing:0)" id="PercentWorkProcessing" name="PercentWorkProcessing" min="0" max="100">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @* Описание *@
                                    <div class="accordion__item">
                                        <div class="accordion__title">
                                            <div class="accordion__arrow"><span class="accordion__arrow-item ">+</span></div>
                                            <span class="accordion__title-text">Экспертное описание</span>
                                        </div>
                                        <div class="accordion__content">
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="StartDateDescriptionProcessing">Дата начала работ по описанию</label>
                                                        <input class="form-control" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.StartDateDescriptionProcessing?.ToString("yyyy-MM-dd"):string.Empty)" id="StartDateDescriptionProcessing" name="StartDateDescriptionProcessing" type="date">
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label for="EndDateDescriptionProcessing">Дата окончания работ по описанию</label>
                                                        <input class="form-control" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.EndDateDescriptionProcessing?.ToString("yyyy-MM-dd"):string.Empty)" id="EndDateDescriptionProcessing" name="EndDateDescriptionProcessing" type="date">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="PercentWorkDescr">Процент работы (<strong><span id="percentWorkDescrSpan">@(info!=null && info.Attributes!=null ? info?.Attributes?.PercentWorkDescr : 0)</span>%</strong>)</label>
                                                        <input type="range" id="PercentWorkDescr" oninput="$('#percentWorkDescrSpan').html($(this).val())" class="progressDefault" value="@(info!=null && info.Attributes!=null ? info?.Attributes?.PercentWorkDescr:0)" name="PercentWorkDescr" min="0" max="100">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="description">
                                                            Краткое содержание
                                                        </label>
                                                        <textarea name="description" id="description" class="form-control" rows="4" cols="1">@(info != null ? info.Description:string.Empty)</textarea>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="tags">Ключевые теги (через запятую)</label>
                                                        <input type="text" class="form-control" id="tags" value="@(info!=null ?info.Tags:string.Empty)" placeholder="" name="tags">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <label style="color: #ad0300; background: #f2dede; font-weight: 200; display: block; padding: 10px;">                                                        
                                                            <i class="fa fa-exclamation-triangle" aria-hidden="true"></i> Содержит сведения, которые могут быть признаны экстремистскими                                                        
                                                    </label>
                                                    <div class="flx">
                                                        <input @( isExrimistStatements ? "checked" : string.Empty ) type="checkbox" name="isExrimistStatements" id="exrimistStatements">
                                                        <label for="exrimistStatements">Checkbox</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="isExrimistStatementsText" @(!isExrimistStatements ? "style=display:none;" : string.Empty)>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label for="exrimistStatementsText">
                                                                Описательное поле где именно находится экстримистское содержние
                                                            </label>
                                                            <textarea name="exrimistStatementsText" id="exrimistStatementsText" class="form-control" rows="4" cols="1">@(info != null && info.Attributes!=null ? info.Attributes.exrimistStatementsText:string.Empty)</textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <h3>Характеристики</h3>
                                                    </div>
                                                </div>
                                            </div>
                                            @* Язык *@
                                            <div class="row">
