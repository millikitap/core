            delete(themeId) {
                var method = 'ThemeAction';
                var data = { type: 'Delete', Id: themeId };
                call('#theme_' + themeId, this.method, data, data.type);
            }
            add(Name, Id) {
                var el = $(Id).find('[type="text"]');
                var ru = $(el[0]).val();
                var en = $(el[1]).val();
                var ar = $(el[2]).val();
                var data = { type: 'Add', ru: ru, en: en, ar: ar };
                var type = "Add";
                call(Id, this.method, data, type);
            }
            update(themeId) {
                var el = $('#theme_' + themeId).find('[type="text"]');
                var ru = $(el[0]).val();
                var en = $(el[1]).val();
                var ar = $(el[2]).val();
                var data = { type: 'Update', Id: themeId, ru: ru, en: en, ar: ar };
                call(null, this.method, data, data.type);
            }
            getAll(id) {
                console.log('update Theme', id);
                var method = 'ThemeAction';
                var data = { type: 'GetAll' };
                call(id, this.method, data, data.type);
            }
        }
