                                                        <textarea name="CommentExpert" id="description" class="form-control" rows="4" cols="1"
                                                                  placeholder="Примечание эксперта">@(info!=null && info.Attributes != null ? info?.Attributes.CommentExpert:string.Empty)</textarea>
                                                    }
                                                    else
                                                    {
                                                        <textarea disabled readonly name="CommentExpert" id="description" class="form-control" rows="4" cols="1"
                                                                  placeholder="Примечание эксперта">@(info!=null && info.Attributes != null ? info?.Attributes.CommentExpert:string.Empty)</textarea>
                                                    }
                                                }
                                                else
                                                {
                                                    <textarea disabled readonly name="CommentExpert" id="description" class="form-control" rows="4" cols="1"
                                                              placeholder="Примечание эксперта">@(info!=null && info.Attributes != null ? info?.Attributes.CommentExpert:string.Empty)</textarea>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="CommentEditor">
                                                Примечание суперэксперта
                                            </label>
                                            <textarea @(!isGrantUser ? "readonly disabled" : string.Empty) name="CommentEditor" id="CommentEditor" class="form-control" rows="4" cols="1"
                                                      placeholder="Примечание суперэксперта">@(info!=null && info.Attributes!=null ? info?.Attributes.CommentEditor : string.Empty)</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="note"> Права доступа для книги (эксперт): </label>
                                            @{
                                                if (usersForControlBook != null && usersForControlBook.Any())
                                                {
                                                    var group = usersForControlBook?.GroupBy(c => new { c.Roles })?.OrderByDescending(c => c.Key.Roles).ToList();
                                                    <select name="userId" required class="form-control">
                                                        <option></option>
                                                        @foreach (var g in group)
                                                        {
                                                            string groupStr = !string.IsNullOrEmpty(g.Key.Roles) ? g.Key.Roles : "Users";
                                                            <optgroup label="@groupStr">@groupStr</optgroup>
                                                            foreach (var i in g)
                                                            {
                                                                if (info != null && info.UserExpert != null)
                                                                {
                                                                    if (info.UserExpert.UserId == i.UserId)
                                                                    {
                                                                        <option selected value="@i.UserId">@i.UserName (@i.FirstName)</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@i.UserId">@i.UserName (@i.FirstName)</option>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <option value="@i.UserId">@i.UserName (@i.FirstName)</option>
                                                                }

                                                            }
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-success" role="alert"><i class="fa fa-lock" aria-hidden="true"></i> Книга доступна только Вам и редакторам</div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Опубликовать</label>
                                        <div class="flx">
                                            <input type="checkbox" name="visible" id="visibleBook" @(info != null ? info.Visible ? "checked" : string.Empty : string.Empty) />
                                            <label for="visibleBook" style="@(isExrimistStatements?"pointer-events:none;opacity:0.3;":string.Empty)">Checkbox</label>
                                        </div>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o" aria-hidden="true"></i> Сохранить</button>
                                if (info != null)
                                {
                                    <button type="button" onclick="removeOperation(1,@info.BookId)" class="btn btn-danger"><i class="fa fa-trash" aria-hidden="true"></i> Удалить</button>
                                }
                            }
                        </div>
                        @* Загрузка сканов *@
                        @{
                            if (isGrantUser)
                            {
                                <div class="tab-pane" id="attach" role="tabpanel">
                                    <div>
                                        @if (info != null)
                                        {
                                            <div class="alert alert-info alert-dismissible" role="alert">
                                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
                                                Загрузка файла(ов) начинается автоматически, после выбора.
                                            </div>

                                            <div class="form-control">
                                                <p><strong>Вариант загрузки:</strong></p>
                                                <div id="param_loader">
                                                    <input type="radio" data-type="1" id="img_down" name="param_loader" value="1">
                                                    <label for="img_down">Загрузка изображений (формат графических файлов)</label>
                                                </div>
                                                <div>
                                                    <input type="radio" data-type="2" id="zip_down" name="param_loader" value="2">
                                                    <label for="zip_down">Загрузка ZIP архива(7-Zip)</label>
                                                </div>
                                            </div>
                                            <br />
                                            <article id="param_uploader_1" class="c-card c-card--external c-card--flight c-flight-card" style="display:none;" layout="row">
                                                <div class="c-card__body" layout="row nowrap" xs-layout="row wrap" flex>
                                                    <div id="fileuploader">Загрузить страницы</div>
                                                </div>
                                            </article>
                                            <article id="param_uploader_2" class="c-card c-card--external c-card--flight c-flight-card" style="display:none;" layout="row">
                                                <div class="c-card__body" layout="row nowrap" xs-layout="row wrap" flex>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <div class="progress" id="progress_zip" style="display:none;">
                                                                <div class="progress-bar progress-bar-striped progress-bar-animated bar"></div>
                                                                <div class="percent">0%</div>
                                                            </div>
                                                            <div id="status"></div>
                                                            <form class="form-group" action="@Url.Action("uploadZIP", "TimesMachine")" id="zipUploader" method="post" enctype="multipart/form-data">
                                                                <input type="hidden" name="i" value="@info.BookId" />
                                                                <input id="inputZIPFile" style="background: #2f8ab9; color: white;margin-bottom: 5px;" class="form-control" type="file" accept=".zip,.7zip" name="file">
                                                                <button class="btn btn-primary" type="submit" id="uploadZIP_btn"><i class="fa fa-cloud-upload" aria-hidden="true"></i> Начать загрузку ZIP</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </article>
                                        }
                                        else
                                        {
                                            <article class="c-card c-card--external c-card--flight c-flight-card" layout="row">
                                                <div class="c-card__body" layout="row nowrap" xs-layout="row wrap" flex>

                                                    <div class="alert alert-danger alert-dismissible" role="alert">
                                                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
                                                        Прежде, чем загружать страницы (сканы), необходимо сохранить книгу
                                                    </div>

                                                </div>
                                            </article>
                                        }
                                        @if (info != null)
                                        {
                                            <br />
                                            <div>
                                                <div class="panel panel-default">
                                                    <div class="list-group" id="prev_images">
                                                        @if (info.Pages != null && info.Pages.Any())
                                                        {
                                                            string prefics = "small_";
                                                            <table class="dataTable no-footer" role="grid">
                                                                <thead>
                                                                    <tr>
                                                                        <td class="l" colspan="4">
                                                                            <i class="fa fa-folder-open-o" aria-hidden="true"></i> @pathBook
                                                                        </td>
                                                                    </tr>
                                                                    @* Выборочное оставление изображений *@
                                                                    <tr>
                                                                        <td class="l" colspan="4">
                                                                            <div class="dropdown">
                                                                                <button class="btn btn-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                                                    <i class="fa fa-scissors" aria-hidden="true"></i>
                                                                                </button>
                                                                                <div class="dropdown-menu" aria-labelledby="dropdownMenu2">
                                                                                    <a class="dropdown-item" onclick="cutOptionFunction(true)">Выборочное оставление изображений</a>
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                    <tr id="cutOptions" style="display:none;">
                                                                        <td class="l" colspan="4">
                                                                            <div class="alert alert-default alert-dismissible" role="alert">
                                                                                <center>Установите интервал страниц <strong>'С-По'</strong>, которые необходимо оставить (<strong>включительно</strong>)</center>
                                                                                <div class="container">
                                                                                    <input type="text" class="js-range-slider" id="cutSliderPage" name="cutSliderPage" value="" onchange="updateCutRowTables()" />
                                                                                    <div class="form-group">
                                                                                        <center>
                                                                                            <input type="button" class="btn btn-primary" onclick="cutImagesApply()" value="Оставить изображения только в указанном диапазоне" />
                                                                                            <input type="button" onclick="cutOptionFunction(false)" class="btn btn-default" value="Закрыть" />
                                                                                        </center>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                    <tr id="pagesLoadingIndicator" style="display:none;">
                                                                        <td class="l" colspan="4">
                                                                            <div class="progress">
                                                                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: 100%"></div>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="pagesTableRows">
                                                                    @{
                                                                        //итератор последовательный
                                                                        int i = 1;
                                                                        //итератор, только для видимых
                                                                        int iVisIterator = 1;
                                                                        //проверка на удаленные страницы
                                                                        bool isHaveRemoved = false;
                                                                        if (info != null && info?.Pages != null && info.Pages.Any())
                                                                        {
                                                                            isHaveRemoved = info.Pages.Where(c => !c.Visible).Any();
                                                                        }
                                                                    }
                                                                    @foreach (var p in info.Pages)
                                                                    {
                                                                        <tr data-enum="@i" class="page_image @(p.Visible?" cutImgVisible":"deletePage hide")" id="rect_@p.Id">
                                                                            <td>
                                                                                <label class="prevCheck" title="Установить в качестве обложки">
                                                                                    <i class="fa fa-picture-o" aria-hidden="true"></i>
                                                                                    @{
                                                                                        var isChecked = false;
                                                                                        if (!string.IsNullOrEmpty(info.BookCoverFileName))
                                                                                        {
                                                                                            if (p.FileName == info.BookCoverFileName.Replace("small_", string.Empty))
                                                                                            {
                                                                                                isChecked = true;
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                    <input @(isChecked ? "checked" : string.Empty) page-id="@p.Id" book-id="@info.BookId" data-src="small_@p.FileName" type="checkbox" />
                                                                                </label>
                                                                                <img loading="lazy" src="@pathBook@prefics@p.FileName" />
                                                                            </td>
                                                                            <td class="l">
                                                                                <a target="_blank" href="@Url.Action("View", "TimesMachine", new { @BookId = info.BookId, @pageId = p.Id })">
                                                                                    <div title="Номер страницы (порядковый)" class="wrap"><strong>@Html.Raw(string.Format("стр. <span class=\"img_page iteratorCutUpdate\">{0}</span>", iVisIterator))</strong></div>
                                                                                    <div title="Истинный номер страницы, который был присвоен в процессе загрузки" class="wrap pageRealNumber" style="display:none;">@Html.Raw(string.Format("стр. <span class=\"img_page\">{0}</span>", i))</div>
                                                                                    <span class="wrap">@p.FileName</span>
                                                                                </a>
                                                                                <p>@(p.DateTimeCreated.HasValue ? string.Format("добавлена: {0}", p.DateTimeCreated.Value) : string.Empty)</p>
                                                                            </td>
                                                                            <td class="l">
                                                                                @{
                                                                                    if (p.RectAreasViewer != null && p.RectAreasViewer.Any())
                                                                                    {
                                                                                        <span>@p.RectAreasViewer.Count() (кол-во фрагментов)</span>
                                                                                    }
                                                                                }
                                                                            </td>
                                                                            <td class="l">
                                                                                <div class="dropdown">
                                                                                    <button class="btn btn-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                                                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                                                                    </button>
                                                                                    <div class="dropdown-menu" aria-labelledby="dropdownMenu2">
                                                                                        <a class="dropdown-item" href="@Url.Action("Edit", new { @BookId = info.BookId, pageId = p.Id })">Изменить</a>
                                                                                        <a class="dropdown-item" onclick="removeOperation(2,@p.Id)">Удалить</a>
                                                                                    </div>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                        i++;
                                                                        if (p.Visible)
                                                                        {
                                                                            iVisIterator++;
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>
                            }
                        }
                        @* Справочники *@
