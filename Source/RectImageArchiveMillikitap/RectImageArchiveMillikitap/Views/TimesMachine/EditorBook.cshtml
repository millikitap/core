        //Язык
        class Langs {
            constructor() {
                this.method = "LangAction";
            }
            delete(langId) {
                var method = 'LangAction';
                var data = { type: 'Delete', Id: langId };
                call('#lang_' + langId, this.method, data, data.type);
            }
            add(Name) {
                var data = { type: 'Add', name: Name };
                call('#LangId', this.method, data, data.type);
            }
            update(langId) {
                var val = $('#lang_' + langId).find('[type="text"]').val();
                var data = { type: 'Update', Id: langId, name: val };
                call(null, this.method, data, data.type);
            }
            getAll() {
                var method = 'LangAction';
                var data = { type: 'GetAll' };
                call('#LangId', this.method, data, data.type);
            }
        }
        //Состояние
        class States {
            constructor() {
                this.method = "StateAction";
            }
            delete(stateId) {
                var data = { type: 'Delete', Id: stateId };
                call('#state_' + stateId, this.method, data, data.type);
            }
            add(Name, Id) {
                var el = $(Id).find('[type="text"]');
                var val = $(el[0]).val();
                var data = { type: 'Add', name: val };
                var type = "Add";
                call(Id, this.method, data, type);
            }
            update(stateId) {
                var id = stateId;
                var val = $('#state_' + stateId).find('[type="text"]').val();
                var data = { type: 'Update', Id: id, name: val };
                call(null, this.method, data, data.type);
            }
            getAll(id) {
                console.log('update State', id);
                var data = { type: 'GetAll' };
                call(id, this.method, data, data.type);
            }
        }
        //Тематика
