        function initProgressChange() {
            var el = $('#main [type="range"]');
            var count = el.length;
            var info = $('#progress_book');
            $(el).on('input', function () {
                var val = 0;
                $(el).each(function () {
                    val += parseInt($(this).val());
                });
                val = parseInt(val / count);
                var res = val + '%';
                $(info).html(res);
                $(info).css('width', res).attr('aria-valuenow', val);
            });
        }
        var cutSliderPage;
        function initRangeSlider() {
            try {
                var minValue = 0, maxValue = 0;
                //all active page
                var pages = $('.cutImgVisible');
                if (pages != null && pages.length > 0) {
                    minValue = parseInt($(pages[0]).attr('data-enum'));
                    maxValue = parseInt($(pages[pages.length - 1]).attr('data-enum'));
                    console.log('min: ' + minValue + "\r\n" + 'max: ' + maxValue);
                }
                $("#cutSliderPage").ionRangeSlider({
                    skin: "round",
                    step: 1,
                    type: "double",
                    grid: true,
                    grid_snap: true,
                    min: minValue,
                    max: maxValue,
                    from: minValue,
                    to: maxValue,
                    prefix: "стр."
                });
                cutSliderPage = $("#cutSliderPage").data("ionRangeSlider");
                cutSliderPage.update({
                    from: minValue,
                    to: maxValue
                });
            }
            catch (ex) {

            }
        }
        var intervalUpdateCutRowTables = null;
        function updateCutRowTables() {
            var loading = $('#pagesLoadingIndicator'),
                pagesRowsTable = $('#pagesTableRows');
            try {

                $(loading).show();
                $(pagesRowsTable).addClass('deletePage');

                var from = cutSliderPage.result.from;
                var to = cutSliderPage.result.to + 1;
                //console.log('from: ' + from + "\r\n" + 'to: ' + to);
                //all elements
                if (intervalUpdateCutRowTables != null) {
                    clearTimeout(intervalUpdateCutRowTables);
                    intervalUpdateCutRowTables = null;
                }
                intervalUpdateCutRowTables = setTimeout(function () {
                    $('.page_image').addClass('hide');
                    for (var i = from; i < to; i++) {
                        //get element
                        var elFinder = $('#prev_images [data-enum="' + i + '"]');
                        if (elFinder != null && elFinder.length > 0) {
                            if (!($(elFinder).hasClass('deletePage'))) {
                                $(elFinder).removeClass('hide');
                            }
                        }
                    }
                    pageOrderUpdate();
                    clearTimeout(intervalUpdateCutRowTables);
                    intervalUpdateCutRowTables = null;

                    $(loading).hide();
                    $(pagesRowsTable).removeClass('deletePage');
                }, 1500);
            }
            catch (ex) {
                $(loading).hide();
                $(pagesRowsTable).removeClass('deletePage');
            }
        }
        //обрезать книгу по интервалу страниц
        function cutImagesApply() {
            var conf = confirm("Пожалуйста, убедитесь в том, что параметры интервала выставлены верно.\r\nВсе изображения, которые не входят в данный интервал - будут удалены!\r\nПродолжить операцию?");
            if (conf) {
                var loading = $('#pagesLoadingIndicator'),
                    pagesRowsTable = $('#pagesTableRows');

                //элементы, которые нужно оставить (id страниц)
                var tempArrayId = [];
                var filteredCutPages = $('.page_image.cutImgVisible:not(.hide)');
                if (filteredCutPages != null && filteredCutPages.length > 0) {
                    //страницы, которые нужно оставить
                    $(filteredCutPages).each(function () {
                        var intId = parseInt($(this).attr('id').replace('rect_', ''));
                        tempArrayId.push(intId);
                    });
                    //идентификатор книги
                    var bookId = parseInt($('#BookId').val());

                    console.log('bookId', bookId);
                    console.log('array Ids', tempArrayId);

                    $(loading).show();
                    $(pagesRowsTable).addClass('deletePage');

                    $.ajax({
                        type: "POST",
                        url: '/TimesMachine/RemovePageArray',
                        data: { bookId: bookId, pagesId: tempArrayId },
                        dataType: 'json',
                        success: function (data) {

                            $(loading).hide();
                            $(pagesRowsTable).removeClass('deletePage');

                            if (data.result == 200) {
                                alert('Действие успешно выполнено. Перезагружаем страницу...');
                                location.reload();
                            } else if (data.result == 403) {
                                alert('Не доступа для выполнения этой операции');
                            } else if (data.result == 500) {
                                alert('Ошибка сервера. Попробуйте еще раз...');
                            } else if (data.result == 100) {
                                alert('Ошибка: пустой параметр tempArrayId');
                            }
                        }, error: function () {
                            alert('Ошибка при выполнении усечения страниц');

                            $(loading).hide();
                            $(pagesRowsTable).removeClass('deletePage');
                        }
                    });
                }
            }
        }
        //форма усечения изображений
        function cutOptionFunction(visible) {
            if (visible) {
                $('#cutOptions,.pageRealNumber').show('300');
            }
            else {
                $('#cutOptions,.pageRealNumber').hide('300');
                cutSliderPage.reset();
                pageOrderUpdate();
            }
        }
