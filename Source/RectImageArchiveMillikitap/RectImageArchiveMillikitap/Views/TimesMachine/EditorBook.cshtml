        function removeOperation(param, id) {
            if (param == 1) {
                //remove book
                var res = confirm('Вы подтверждаете удаление книги?');
                if (res) {
                    $.ajax({
                        type: "POST",
                        url: '/TimesMachine/RemoveBook',
                        data: { id: id },
                        dataType: 'json',
                        success: function (data) {
                            if (data.result == 200) {
                                alert('Книга успешно удалена.');
                                document.location.href = "/TimesMachine/ControlPanel";
                            } else if (data.result == 403) {
                                alert('Ошибка доступа');
                            } else if (data.result == 404) {
                                alert('Не найдена или удалена');
                            } else if (data.result == 500) {
                                alert('Ошибка в процессе удаления');
                            }
                        }, error: function () {
                            alert('Ошибка при удалении книги');
                        }
                    });
                }
            }
            else if (param == 2) {
                //remove page
                var res = confirm('Вы подтверждаете удаление страницы?');
                if (res) {
                    var obj = $('#rect_' + id);
                    $.ajax({
                        type: "POST",
                        url: '/TimesMachine/RemovePage',
                        data: { id: id },
                        dataType: 'json',
                        success: function (data) {
                            if (data.result == 200) {
                                alert('Страница успешно удалена.');
                                $(obj).remove();
                                pageOrderUpdate();
                                initRangeSlider();
                            } else if (data.result == 403) {
                                alert('Ошибка доступа');
                            } else if (data.result == 404) {
                                alert('Не найдена или удалена');
                            } else if (data.result == 500) {
                                alert('Ошибка в процессе удаления');
                            }
                        }, error: function () {
                            alert('Ошибка при удалении страницы');
                        }
                    });
                }
            }
        }
        function pageOrderUpdate() {
            var el = $('.page_image.cutImgVisible:not(.hide)');
            if (el != null && el.length > 0) {
                $(el).each(function (index, value) {
                    var el = $(this).find('.iteratorCutUpdate');
                    $(el).html(index + 1);
                });
            }
        }
    </script>
