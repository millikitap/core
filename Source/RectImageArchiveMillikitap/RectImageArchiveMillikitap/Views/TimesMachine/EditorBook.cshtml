        function isExrimistStatementsInit() {
            var elParamExrimist = $('#isExrimistStatementsText');
            $('#exrimistStatements').on('change', function () {
                if ($(this).prop('checked')) {                    
                    $(elParamExrimist).show('200');
                    $('#visibleBook').prop('checked', false);
                    $('label[for="visibleBook"]').css('pointer-events', 'none').css('opacity', '0.3');
                }
                else {
