        function init_uploaderZIP() {
            var bar = $('.bar');
            var percent = $('.percent');
            var status = $('#status');
            var btn = $('#uploadZIP_btn');
            var form = $('#inputZIPFile');
            var progress = $('#progress_zip');

            $('#zipUploader').ajaxForm({
                beforeSend: function () {
                    status.empty();
                    var percentVal = '0%';
                    bar.width(percentVal);
                    percent.html(percentVal);
                },
                uploadProgress: function (event, position, total, percentComplete) {
                    $(progress).show();
                    var percentVal = percentComplete + '%';
                    bar.width(percentVal);
                    percent.html(percentVal);
                    console.log(event);
                    if (percentComplete == 100) {
                        status.html('Файл загружен. Операция обработки и распаковки. Пожалуйста, ждите...');
                        $(bar).hide();
                        $(percent).hide();
                        $(btn).hide();
                        $(form).hide();
                    }
                },
                complete: function (xhr) {
                    status.html(xhr.responseJSON);
                    if (xhr.responseJSON.Result) {
                        alert('Файлы успешно распакованы. Перезагружаем страницу.');
                        location.reload();
                    }
                    else {
                        alert('Ошибка при выполнении операции.');
                    }
                    $(bar).show();
                    $(percent).show();
                    $(btn).show();
                    $(form).show();
                }
            });
        }
        //функция смены обложки
        function bookCoverInit() {
            $('#prev_images [type="checkbox"]').on('change', function () {
                var src = $(this).attr('data-src');
                var bookId = $(this).attr('book-id');
                var pageId = $(this).attr('page-id');
                var allChecked = $('#prev_images [type="checkbox"]');
                var otherInput = jQuery.grep(allChecked, function (a) {
                    return $(a).attr('page-id') != pageId;
                });
                if (otherInput.length > 0) {
                    jQuery.grep(otherInput, function (a) {
                        return $(a).prop('checked', false);
                    });
                }
                var currCheckState = $(this).prop('checked');
                console.log(currCheckState + " " + bookId + " " + src);
                setCoverIBook(bookId, currCheckState, src)
            });
        }
        //Установка обложки для книги
        function setCoverIBook(bookId, currCheckState, src) {
            $.ajax({
                type: "POST",
                url: '/TimesMachine/SetCoverBook',
                data: { bookId: bookId, currCheckState: currCheckState, src: src },
                dataType: 'json',
                success: function (data) {
                    if (data.result == 200) {
                        alert('Обложка успешно изменена.');
                        $('#coverImg').attr('src', pathBook + src);
                    } else if (data.result == 403) {
                        alert('Ошибка доступа');
                    } else if (data.result == 404) {
                        alert('Книга не найдена или удалена');
                    } else if (data.result == 500) {
                        alert('Ошибка в процессе изменения обложки');
                    }
                }, error: function () {
                    alert('Ошибка при изменении обложки');
                }
            });
        }
        function param_loaderInit() {
            var params = $('[name="param_loader"]');
            $(params).on('change', function () {
                var attr = $(this).attr('data-type');
                $('#attach').find('article').hide();
                $('#param_uploader_' + attr).show();
