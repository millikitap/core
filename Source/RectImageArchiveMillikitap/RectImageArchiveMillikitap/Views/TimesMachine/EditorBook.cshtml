        //add new event
        function initAddNewRow() {
            $('#add_lang').on('click', function () {
                var id = 'lang_' + new Date().valueOf();
                var table = $('#table-languages tbody:first');
                var stroke = '<tr id="' + id + '" style="background-color: #d9d9d9;"><td></td><td><input required="" type="text" class="form-control" placeholder="Название"></td><td><input required="" type="number" class="form-control" placeholder="LangId"></td><td><button type="button" class="btn btn-sm btn-default" onclick="rowSave("' + id + '");"> <span class="fa fa-check"> </span> </button></td></tr>'
