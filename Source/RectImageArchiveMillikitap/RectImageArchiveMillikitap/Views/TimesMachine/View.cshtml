@* Записаться в волонтеры *@
<div id="feedback" class="main">
    <span onclick="$('#feedback').css('display','none')" class="material-icons closeFeedback">
        cancel
    </span>
    <div class="bio">
        <h3 class="header">@Locale["Вступление_в_волонтеры"]</h3>
        <p>
            @Locale["Мы_приглашаем_всех_желающих"]
        </p>
        @Locale["Если_Вы_знаете_такие_языки_как"]
        <p>
            @Locale["Если_Вы_получите одобрение"]
        </p>
    </div>
    <div class="logoFeedback">
        <img class="profile-img" src="@Url.Content("/Content/Images/logo_main.png")" />
    </div>
    <div class="contact">
        <form id="form">
            <legend class="header">@Locale["Оставьте_заявку"]</legend>
            <p>
                @Locale["Напишите_несколько_слов_о_себе"]
            </p>
            <fieldset>
                <label class="material-icons" for="message-input" aria-hidden="true">email</label>
                <textarea placeholder="@Locale["О_себе"]" id="message-input"></textarea>
            </fieldset>
            <fieldset>
                <button onclick="$('#feedback').css('display', 'none'); toastMess('Спасибо за обратную связь', false);" type="button" id="btn-submit">@Locale["Отправить_заявку"]</button>
            </fieldset>
        </form>
    </div>
</div>

<body class="@(!Model.Visible ? "isBookHide" : string.Empty)">
    @* Curr user *@
    @{
        if (currUser != null)
        {
            <input type="hidden" id="UserId" value="@currUser.UserId" />
            <input type="hidden" id="UserCode" value="@currUser.ActivationCode" />
            <input type="hidden" id="UserEmail" value="@currUser.Email" />
            <input type="hidden" id="UserFirstName" value="@(currUser?.FirstName)" />
            <input type="hidden" id="UserLastName" value="@(currUser?.LastName)" />
            <script>
                var userIsAuth = true;
            </script>
        }
        else
        {
            <script>
                var userIsAuth = false;
            </script>
        }
    }
    <script>
        @* Loader page *@
        var loader_number = 4;
        var preloader_number = 4;
        @* isEditor || isAdmin || isExpert *@
        var isHasAccess = false;
        @{
            if (HasAccess)
            {
                <text>
                    isHasAccess = true;
                </text>
            }
            else
            {
                <text>
                    isHasAccess = false;
                </text>
            }
        }
    </script>
    <div class="preloader-4">
        <div class="loader-4" title="@Locale["Открытие"]"></div>
    </div>

    <div class="loader">
        <h2>@Locale["Пожалуйста_ждите"]</h2>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--dot"></div>
        <div class="loader--text"></div>
    </div>
    <div id="controlsBtnViewport">
        <span onclick="rotateLeft()" title="@Locale["Повернуть_налево"]" class="material-icons btn_option BtnViewportControl rotateCtrlView">rotate_left</span>
        <span onclick="hideZoom()" title="@Locale["Закрыть_окно_увеличения"]" class="material-icons btn_option BtnViewportControl">highlight_off</span>
        <span onclick="rotateRight()" title="@Locale["Повернуть_направо"]" class="material-icons btn_option BtnViewportControl rotateCtrlView">rotate_right</span>
    </div>
    <div class="panel_slide-wrap">
        <div class="panel_slide">
            <h3 id="slidingTitle">
                <span class="material-icons">auto_stories</span><label>@Model.BookName</label>
                <span id="closeSlidingCtrl" title="@Locale["Скрыть"]" class="material-icons btn_option"> keyboard_arrow_right </span>
                <span id="likeCtrl" title="@Locale["Добавить_выделенную_статью_в_избранное"]" class="material-icons btn_option"> favorite </span>
                <span id="fullscreenCtrl" title="@Locale["На_весь_экран"]" class="material-icons btn_option"> open_in_full </span>
            </h3>
            <div id="slidingContent"></div>
        </div>
        <div id="footerContent">
            <span id="linkSocFragment" class="r_b ya-share2" data-popup-direction="top" data-curtain data-color-scheme="blackwhite" data-limit="0" data-more-button-type="short" data-services="vkontakte,facebook,odnoklassniki,telegram,whatsapp"></span>
        </div>
    </div>
    @* openseadragon  *@
    <div id="zoomDocument" class="openseadragon" style="width:100%;height:100%;border:0px;visibility:hidden;position:fixed;z-index: 200;padding-top:58px;"></div>
    <header id="header" class="codrops-header">
        <div id="logo" class="news_paper_title">
            <a href="@Url.Action("Index", "TimesMachine")" title="@Locale["Перейти_на_главную_страницу"]">
                <img width="55" src="~/Content/Images/logo_main.png?v=@version" class="custom-logo" srcset="~/Content/Images/logo_main.png?v=@version" sizes="(max-width: 300px) 100vw, 300px">
            </a>
        </div>
        <div class="flex_c">
            @if (Model != null)
            {
                if (Model.isRtl.HasValue && Model.isRtl.Value)
                {
                    <span class="material-icons btn_option stepBtn" data-pos="-"> keyboard_arrow_left </span>
                    <span>@Locale["из"]</span>
                    <strong><span id="allPages" class="pageNumber">0</span></strong>
                    <span> - </span>
                    <strong>
                        <span title="@Locale["Двойной_клик_для_редактирования"]" id="pageNumber" class="pageNumber">0</span>
                    </strong>
                    <span class="material-icons btn_option stepBtn" data-pos="+"> keyboard_arrow_right </span>
                    <text>
                        <script>
                            var isRtl = true;
                        </script>
                    </text>
                }
                else
                {
                    <span class="material-icons btn_option stepBtn" data-pos="-"> keyboard_arrow_left </span>
                    <strong>
                        <span title="@Locale["Двойной_клик_для_редактирования"]" id="pageNumber" class="pageNumber">0</span>
                    </strong>
                    <span>@Locale["из"]</span>
                    <strong><span id="allPages" class="pageNumber">0</span></strong>
                    <span class="material-icons btn_option stepBtn" data-pos="+"> keyboard_arrow_right </span>
                    <text>
                        <script>
                            var isRtl = false;
                        </script>
                    </text>
                }
            }
            @if (booksInCollections != null && booksInCollections.Any())
            {
                <div class="collections">
                    <select id="changeCollectionSelect" title="@Locale["Переключиться_на_другую_часть_сборника"]" class="collectionSelect">
                        @{
                            int i = 1;
                            foreach (var c in booksInCollections)
                            {
                                if (c.BookId == Model.BookId)
                                {
                                    <option style="@(!c.Visible.Value ? "display:none" : string.Empty)" data-id="@c.BookId" selected>
                                        @Locale["Часть"] @i @(string.Format("({0} {1})", c.PageCount, Locale["стр"]))
                                    </option>
                                }
                                else
                                {
                                    <option style="@(!c.Visible.Value ? "display:none" : string.Empty)" data-id="@c.BookId">
                                        @Locale["Часть"] @i @(string.Format("({0} {1})", c.PageCount, Locale["стр"]))
                                    </option>
                                }
                                i++;
                            }
                        }
                    </select>
                </div>
            }
            <span id="layersCtrl" title="@Locale["Показать_Скрыть_слои"]" class="material-icons btn_option" style="display:none;"> layers </span>
            @{
                if (HasAccess)
                {
                    <a title="@Locale["Редактировать_книгу"]" href="@Url.Action("EditorBook", "TimesMachine", new { @BookId = Model.BookId })"><span class="material-icons btn_option"> edit_note </span></a>
                }
            }
            @if (!string.IsNullOrEmpty(Model.PdfFile))
            {
                <a title="@Locale["Одним_файлом"]" href="~/Books/@Model.HashFolder/@Model.PdfFile"><span class="material-icons btn_option"> picture_as_pdf </span></a>
            }
            <button class="slider-switch" style="display:none">Switch view</button>
        </div>
    </header>
    <div class="container mt-5" id="bookInfoForm" style="display:none;">
        <div class="row">
            <div class="col-12">
                <article class="blog-card-info">
                    <div class="blog-card-info__background">
                        <div class="card__background--wrapper">
                            @{
                                string coverImg = Url.Content("/Content/Images/notImage.png");
                                if (!string.IsNullOrEmpty(Model.BookCoverFileName))
                                {
                                    coverImg = string.Format("/Books/{0}/{1}", Model.HashFolder, Model.BookCoverFileName.Replace("small_", string.Empty));
                                }
                            }
                            <div class="card__background--main" style="background-image: url('@coverImg');">
                                <div class="card__background--layer"></div>
                            </div>
                        </div>
                    </div>
                    <div class="blog-card-info__info">
                        <h3>@Model.BookName</h3>

                        @* Содержание рукописи *@
                        <div class="accordion form-group">
                            <div class="accordion__item">
                                <div class="accordion__title">
                                    <div class="accordion__arrow"><span class="accordion__arrow-item ">+</span></div>
                                    <span class="accordion__title-text">@Locale["Содержание_рукописи"]</span>
                                </div>
                                <div class="accordion__content" style="display: none;">
                                    <div class="caption">
                                        <span>@Locale["Название_на_разных_языках"]:</span>
                                    </div>
                                    <div class="description">
                                        <div><span class="title">@Locale["Оригинал"]:</span> @Model.BookName</div>
                                        @{
                                            if (Model.Attributes != null)
                                            {
                                                <div><span class="title">ru: </span> @Model.Attributes.NameOfBookCyrillic</div>
                                                <div><span class="title">en: </span> @Model.Attributes.NameOfBookEnglish</div>
                                                <div><span class="title">ar: </span> @Model.Attributes.NameOfBookArabic</div>
                                            }
                                            else
                                            {
                                                <div><span class="title">ru: </span>-</div>
                                                <div><span class="title">en: </span>-</div>
                                                <div><span class="title">ar: </span>-</div>
                                            }
                                        }
                                    </div>
                                    <div class="caption">
                                        <span>@Locale["Описание_книги"]:</span>
                                    </div>
                                    <div class="description">
                                        <span>
                                            @{
                                                if (!string.IsNullOrEmpty(Model.Description))
                                                {
                                                    @Model.Description
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            }
                                        </span>
                                    </div>
                                    <div class="caption">
                                        <span>@Locale["Тип_на_разных_языках"]:</span>
                                    </div>
                                    <div class="description">
                                        @{
                                            if (Model.Attributes != null && Model.Attributes.TypesLanguagesListId.HasValue)
                                            {
                                                var entityType = typesList?.Where(c => c.TypesLanguagesListId == Model.Attributes.TypesLanguagesListId.Value)?.FirstOrDefault();
                                                if (entityType != null)
                                                {
                                                    <div><span class="title">ru: </span> @entityType.DescriptionTypeRussian</div>
                                                    <div><span class="title">en: </span> @entityType.DescriptionTypeEnglish</div>
                                                    <div><span class="title">ar: </span> @entityType.DescriptionTypeArabic</div>
                                                }
                                                else
                                                {
                                                    <div><span class="title">ru: </span>-</div>
                                                    <div><span class="title">en: </span>-</div>
                                                    <div><span class="title">ar: </span>-</div>
                                                }
                                            }
                                            else
                                            {
                                                <div><span class="title">ru: </span>-</div>
                                                <div><span class="title">en: </span>-</div>
                                                <div><span class="title">ar: </span>-</div>
                                            }
                                        }
                                    </div>
                                    <div class="caption">
                                        <span>@Locale["Тема_на_разных_языках"]:</span>
                                    </div>
                                    <div class="description">
                                        @{
                                            if (Model.Attributes != null && Model.Attributes.ThemesLanguagesListId.HasValue)
                                            {
                                                var entityTheme = themesList?.Where(c => c.ThemesLanguagesListId == Model.Attributes.ThemesLanguagesListId.Value)?.FirstOrDefault();
                                                if (entityTheme != null)
                                                {
                                                    <div><span class="title">ru: </span> @entityTheme.DescriptionThemeRussian</div>
                                                    <div><span class="title">en: </span> @entityTheme.DescriptionThemeEnglish</div>
                                                    <div><span class="title">ar: </span> @entityTheme.DescriptionThemeArabic</div>
                                                }
                                                else
                                                {
                                                    <div><span class="title">ru: </span>-</div>
                                                    <div><span class="title">en: </span>-</div>
                                                    <div><span class="title">ar: </span>-</div>
                                                }
                                            }
                                            else
                                            {
                                                <div><span class="title">ru: </span>-</div>
                                                <div><span class="title">en: </span>-</div>
                                                <div><span class="title">ar: </span>-</div>
                                            }
                                        }
                                    </div>
                                    <div class="caption">
                                        <span>@Locale["Коллекция"]:</span>
                                    </div>
                                    <div class="description">
                                        <div>
                                            @{
                                                if (Model.Attributes != null && Model.Attributes.CollectionId.HasValue)
                                                {
                                                    var entityCollection = collectionsList?.Where(c => c.CollectionId == Model.Attributes.CollectionId.Value)?.FirstOrDefault();
                                                    if (entityCollection != null)
                                                    {
                                                        <div>@entityCollection.CollectionName</div>
                                                    }
                                                    else
                                                    {
                                                        <div>-</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div>-</div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="caption">
                                        <span>@Locale["Теги"]:</span>
                                    </div>
                                    <div class="description">
                                        <div>
                                            @if (Model.Attributes != null)
                                            {
                                                if (!string.IsNullOrEmpty(Model.Tags))
                                                {
                                                    <span>@Model.Tags</span>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
