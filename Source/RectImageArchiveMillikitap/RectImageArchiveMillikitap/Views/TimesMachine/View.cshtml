                    <section class="img-dragger img-dragger-large dragdealer">
                        <div class="handle">
                            @{
                                if (Model != null && Model.Pages != null && Model.Pages.Any())
                                {
                                    int it = 1;
                                    if (Model.isRtl.HasValue && Model.isRtl.Value)
                                    {
                                        Model.Pages = Model.Pages.OrderByDescending(c => c.Id)?.ToList();
                                    }
                                    foreach (var p in Model.Pages)
                                    {
                                        <div class="slide" id="page_@p.Id">
                                            <div class="img-wrap">
                                                <div class="ctrView">
                                                    @{
                                                        if (HasAccess)
                                                        {
                                                            <span id="editCtrl" onclick="navigateToEditor(@Model.BookId,@p.Id); return;" title="@Locale["Редактировать"]" class="material-icons btn_option"> mode_edit </span>
                                                        }
                                                    }
                                                    <span id="fullScreenCtrl" onclick="zoomIn()" title="@Locale["Увеличить"]" class="material-icons btn_option"> fullscreen </span>
                                                </div>
                                                @{
                                                    bool isHaveRects = p.RectAreasViewer != null && p.RectAreasViewer.Any();
                                                    string pid = string.Empty;
                                                    if (isHaveRects)
                                                    {
                                                        pid = "usemap=" + string.Format("#img_{0}", p.Id);
                                                    }
                                                }
                                                <img data-i="@it" data-pgId="@p.Id" loading="lazy" src="~/Content/Images/loading.gif" class="lazy" @pid data-src="@(folderBookUrl+"//"+@p.FileName)" alt="@p.Title" />
                                                <map name="img_@p.Id">
                                                    @{
                                                        if (isHaveRects)
                                                        {
                                                            HtmlDocument doc = new HtmlDocument();
                                                            int i = 1;
                                                            foreach (var r in p.RectAreasViewer)
                                                            {
                                                                doc.LoadHtml(r.RectForViewerSVG);
                                                                string htmlRectRes = string.Empty;
                                                                HtmlNodeCollection nodes = doc.DocumentNode.SelectNodes("//area");
                                                                if (nodes != null && nodes.Any())
                                                                {
                                                                    foreach (var n in nodes)
                                                                    {
                                                                        string shape = n.Attributes["shape"]?.Value;
                                                                        string coords = n.Attributes["coords"]?.Value;
                                                                        string joinAreaResult = string.Format("<area class=\"viewAreaEl\" data-viewerId=\"{0}\" data-pagesId=\"{1}\" shape=\"{2}\"  coords=\"{3}\" originalCoords=\"{3}\"/>", r.RectAreasViewerId, r.PagesId, shape, coords);
                                                                        htmlRectRes += joinAreaResult;
                                                                    }
                                                                }

                                                                @Html.Raw(htmlRectRes)
                                                                i++;
                                                            }
                                                        }
                                                    }
                                                </map>
                                            </div>
                                            <div class="descrSlide">@p.Title</div>
                                        </div>
                                        it++;
                                    }
                                }
                            }
                        </div>
                    </section>
                }
            }
            @* Волонтерство *@
            <button class="buttonFeedback" type="button">
                <span class="material-icons">groups</span> @Locale["Стать_волонтером"]
            </button>
            @* Поделиться *@
            <span id="shareInViewCtrl" onclick="shareMainInit()" title="@Locale["Поделиться_ссылкой_на_страницу"]" class="material-icons btn_option linkInView"> share </span>
            @* О книге *@
            <div class="fork-ribbon-wrapper red fixed" id="bookInfoBtn">
                <div class="fork-ribbon-border"></div>
                <div class="fork-ribbon-container">
                    <div class="fork-ribbon">
                        <div class="fork-ribbon-content">
                            <a href="#">
                                @Locale["О_книге"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

