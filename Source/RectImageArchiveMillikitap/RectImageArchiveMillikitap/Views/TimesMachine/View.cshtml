<div class="bottom_drawer">
    <div class="header_bar">
        <span class="usersOnline">
            <span class="material-icons"> people_alt </span>  @Locale["Сейчас_читают"]: <span class="usersCounter">0</span>
        </span>
        <button class="create">
            <span id="newNotify"></span>
            <span class="material-icons">
                question_answer
            </span> @Locale["Дискуссия"]
        </button>
    </div>
    <div class="body_area">
        <!-- Comments -->
        <div class="comments">
            <div class="comment-body" id="chatMessages">
                <div class="toTopChat">
                    <span onclick="getLastMessageChat(false)" title="@Locale["Загрузить_предыдущие_60_сообщений"]" class="material-icons toTopChatBtn">
                        update
                    </span>
                </div>
                <div id="historyMessages">

                </div>
                <span title="@Locale["К_последним_сообщениям"]" class="material-icons toBottomChat">
                    arrow_circle_down
                </span>
            </div>            
            <div class="comment-box add-comment">
                <span class="commenter-name">
                    <div class="answer_messageIcon">
                        <span class="material-icons">
                            cancel
                        </span>
                    </div>
                    <textarea name="comment" placeholder="@Locale["Текст_сообщения"]"></textarea>
                    <span id="sendMessage" class="material-icons">
                        send
                    </span>
                </span>
                <div id="isWriteMessageView">
                    <span id="isWriteMessagePencilAnim" class="material-icons">edit</span>
                    @* Пользователи, которые набирают текст *@
                    <div id="isWriteMessageViewUsers">

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var audio = null;
    function playNotify(url) {
        audio = document.createElement('audio');
        audio.style.display = "none";
        audio.src = url;
        audio.autoplay = true;
        audio.onended = function () {
            audio.remove();
            audio = null;
        };
        document.body.appendChild(audio);
    }

    function newMessageNotify() {
        $('#newNotify').show();
    }

    var isAnswer = false, idMessageAnswer = null;
    function replyMessage(el) {
        isAnswer = true;
        var dataId = $(el).attr('data-id');
        idMessageAnswer = dataId;
        var mess = $('#mess_' + dataId).find('p:first').text();
        $('.emojionearea-editor').attr('placeholder', '@Locale["Ответ_на_сообщение"] ' + mess);
        $('.emojionearea-editor').addClass('answerChat');
        $('.answer_messageIcon').show();
        $('.emojionearea-editor').focus();
    }

    function clearChat() {
        isAnswer = false;
        idMessageAnswer = null;
        $('[name="comment"]').val('');
        $('.emojionearea-editor').empty();
        $('.emojionearea-editor').attr('placeholder', '@Locale["Текст_сообщения"]');
        $('.answer_messageIcon').hide();
        $('.emojionearea-editor').removeClass('answerChat');
        //Очистка пред-его вложения
        var haveAttachLink = $('.emojionearea #attachLink');
        if (haveAttachLink.length > 0) {
            $(haveAttachLink).remove();
        }
    }

    var inBottomScrollChat = true;
    function bindScrollChatWnd() {
        $('#chatMessages').bind('scroll', function () {
            if ($(this).scrollTop() + $(this).innerHeight() >= $(this)[0].scrollHeight) {
                inBottomScrollChat = true;
                $('#newNotify').hide();
            }
            else {
                inBottomScrollChat = false;
            }
            toBottomVisible(!inBottomScrollChat);
        });
    }

    function toBottomVisible(f) {
        var obj = $('.toBottomChat');
        if (f) {
            $(obj).css('display', 'flex');
        }
        else {
            $(obj).css('display', 'none');
        }
    }

    function scrollChatToBottom() {
        $('.toBottomChat').hide();
        $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
        if ($('.bottom_drawer .body_area').css('display') == 'block' && inBottomScrollChat) {
            $('#newNotify').hide();
        }
    }

    function scrollChatToTop() {
        $('.toBottomChat').hide();
        $('#chatMessages').animate({ scrollTop: 0 }, "slow");
    }

    function offsetChat() {
        if (inBottomScrollChat) {
            scrollChatToBottom();
        }
    }

    function onlineUsersListShow() {
        console.log('show table users online');
    }

    function onlineUsersInit() {
        $('.usersOnline').on('click', function () {
            onlineUsersListShow();
        });
    }

    function initButtonFeedback() {
        $('.buttonFeedback').on('click', function () {
            $('#feedback').css('display', 'flex');
        });
    }
    
    $(document).ready(function () {
        initButtonFeedback();
        var chatInput = $('[name="comment"]');        
        $(chatInput).emojioneArea({
            recentEmojis: false,
            events: {
                keyup: function (editor, event) {
                    if (event.keyCode == 13 && event.shiftKey) {
                        $('#sendMessage').click();                       
                    }
                    //Отображение набора текста
                    isWriteMessage();
                },
                onLoad: function () {
                    $('.emojionearea-button').append('<span id="attach" class="material-icons" aria-hidden="true" title="' + LocaleJs["Вложить_ссылку_на_страницу"] +'">add_link</span>');
                    $('.add-comment #attach').on('click', function () {
                        //Очистка пред-его вложения
                        var haveAttachLink = $('.emojionearea #attachLink');
                        if (haveAttachLink.length > 0) {
                            $(haveAttachLink).remove();
                        }
                        //Вложение (Ссылка на тек. страницу)
                        var imgCurrent = $('.slide.current').find('img:first');
                        if (imgCurrent != null && imgCurrent.length > 0) {
                            var pageId = $(imgCurrent).attr('data-pgid');
                            updateUrlParamInView(pageId);
                        }
                        var pageIdLink = parseInt(getUrlParameter('pageId'));
                        if (pageIdLink != null && pageIdLink != undefined) {
                            var messageBodyContainer = $('.emojionearea');
                            var pageNumber = $('#pageNumber').html();
                            $(messageBodyContainer).append('<div data-pageId="' + pageIdLink + '" id="attachLink"><span onclick="$('+"'#attachLink'"+').remove()" id="removeAttachLink" class="material-icons"> close </span><span style="padding-left: 10px;">Ссылка на страницу №' + pageNumber+'</span></div>');
                        }
                        return false;
                    });
                }
            }
        })         
        $('.create').click(function () {
            $('.body_area').slideToggle('fast', 'swing', function () {                
                scrollChatToBottom();
                var display = $(this).css('display');
                if (display == 'block') {
                    getLastMessageChat(false);
                    $('#newNotify').hide();
                }
                else {

                }
            });
        });
        $('#sendMessage').on('click', function () {
            var messageText = $('.emojionearea-editor').html();
            if (messageText != '' && messageText != ' ') {
                send(messageText);
            }
            else {
                toastMess('@Locale["Введите_текст_сообщения_и_повторите_попытку"]', true);
            }
        });
        $('.answer_messageIcon').on('click', function () {
            clearChat();
        });
        $('.toBottomChat').on('click', function () {
            scrollChatToBottom();
        });
        onlineUsersListShow();
    });
</script>