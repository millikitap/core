@using System.Collections;
@using HtmlAgilityPack;
@{
    @model RectImageArchiveMillikitap.Models.Books
    ViewBag.Title = $"{Model.BookName} {ViewBag.Caption}";
    string folderBookUrl = ViewData["folderBookUrl"] as string;
    var HasAccess = (bool)ViewData["access"];
    //сборник сочинений
    var booksInCollections = ViewData["сollectionDataBook"] as List<RectImageArchiveMillikitap.Models.BooksJson>;
    //текущий пользователь
    var currUser = ViewData["currentUser"] as RectImageArchiveMillikitap.Models.User.User;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Locale = ViewData["Translate"] as Hashtable;

    //Тематики
    var themesList = ViewData["ThemesList"] as List<RectImageArchiveMillikitap.Models.ThemesLanguagesList>;
    //Типы
    var typesList = ViewData["TypesList"] as List<RectImageArchiveMillikitap.Models.TypesLanguagesList>;
    //Коллекции
    var collectionsList = ViewData["CollectionsList"] as List<RectImageArchiveMillikitap.Models.Collection>;

    string version = "3.8.3";
}


